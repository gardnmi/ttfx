diff --git 1/src/engine/scene_runtime/groups.rs 2/src/engine/scene_runtime/groups.rs
new file mode 100644
index 0000000..f255828
--- /dev/null
+++ 2/src/engine/scene_runtime/groups.rs
@@ -0,0 +1,467 @@
+//! Share progress across stationary, non-looping scenes with identical timing.
+//! Visuals remain per character and are committed in the ordinary update order.
+//! During callbacks, the update cursor selects the old or advanced counters;
+//! mutation detaches just that member and restores its individual runtime.
+use super::{Cursor, EasedProgram, SceneRuntime};
+use crate::engine::character::EffectCharacter;
+use crate::engine::playback::PlaybackScheduler;
+use rustc_hash::FxBuildHasher;
+use std::collections::HashMap;
+use std::rc::Rc;
+
+const NONE: usize = usize::MAX;
+const MIN_GROUP: usize = 8;
+const MAX_GROUPS: usize = 1024;
+
+#[derive(Clone, Debug)]
+struct Group {
+    before: Cursor,
+    after: Cursor,
+    eased: Option<Rc<EasedProgram>>,
+    // Sorted, non-overlapping character masks. Mutations clear their own bit.
+    blocks: Vec<(usize, u64)>,
+    count: usize,
+}
+
+#[derive(Clone, Debug)]
+pub(super) struct Groups {
+    slots: Vec<Option<Group>>,
+    owners: Vec<usize>,
+    // 0: unexamined, 1: uniform remaining frames, -1: rejected.
+    shapes: Vec<i8>,
+    members: Vec<u64>,
+    skipped: Vec<u64>,
+    cursor: Option<usize>,
+    woken: Vec<usize>,
+    count: usize,
+    generation: u64,
+    enabled: bool,
+}
+
+impl Default for Groups {
+    fn default() -> Self {
+        Self {
+            slots: Vec::new(),
+            owners: Vec::new(),
+            shapes: Vec::new(),
+            members: Vec::new(),
+            skipped: Vec::new(),
+            cursor: None,
+            woken: Vec::new(),
+            count: 0,
+            generation: 0,
+            enabled: std::env::var_os("TTFX_SCENE_GROUPS").is_none_or(|v| v != "0"),
+        }
+    }
+}
+
+impl Groups {
+    pub(super) fn resize(&mut self, len: usize) {
+        self.owners.resize(len, NONE);
+        self.shapes.resize(len, 0);
+        self.members.resize(len.div_ceil(64), 0);
+        self.skipped.resize(len.div_ceil(64), 0);
+    }
+    pub(super) fn reset_shape(&mut self, id: usize) {
+        self.shapes[id] = 0;
+    }
+}
+
+impl SceneRuntime {
+    pub(crate) fn has_groups(&self) -> bool {
+        self.groups.count != 0
+    }
+
+    #[inline]
+    pub(super) fn group_cursor(&self, id: usize) -> Option<Cursor> {
+        if self.groups.count == 0 {
+            return None;
+        }
+        let slot = self.groups.owners[id];
+        if slot == NONE {
+            return None;
+        }
+        let group = self.groups.slots[slot].as_ref().unwrap();
+        Some(if self.groups.cursor.is_some_and(|cursor| id >= cursor) { group.before } else { group.after })
+    }
+
+    pub(crate) fn group_skip_mask(&self) -> &[u64] {
+        &self.groups.skipped
+    }
+
+    pub(crate) fn set_group_cursor(&mut self, id: usize) {
+        self.groups.cursor = Some(id);
+    }
+
+    pub(crate) fn drain_group_wakes(&mut self, out: &mut Vec<usize>) {
+        out.append(&mut self.groups.woken);
+    }
+
+    /// Also used before explicit public ticks, which advance independently of
+    /// the outer snapshot and must not silently reuse its already-computed tick.
+    #[inline]
+    pub(crate) fn detach_group(&mut self, id: usize) {
+        if let Some(cursor) = self.group_cursor(id) {
+            self.detach_group_cached(id, cursor);
+        }
+    }
+
+    #[inline(never)]
+    fn detach_group_cached(&mut self, id: usize, cursor: Cursor) {
+        self.cursors[id].set(cursor);
+        let slot = self.groups.owners[id];
+        self.groups.owners[id] = NONE;
+        let word = id / 64;
+        let mask = !(1 << (id % 64));
+        self.groups.members[word] &= mask;
+        self.groups.skipped[word] &= mask;
+        let group = self.groups.slots[slot].as_mut().unwrap();
+        let block = group.blocks.binary_search_by_key(&word, |&(word, _)| word).unwrap();
+        group.blocks[block].1 &= mask;
+        group.count -= 1;
+        self.groups.count -= 1;
+        if group.count == 0 {
+            self.groups.slots[slot] = None;
+        }
+        self.groups.woken.push(id);
+    }
+
+    fn dissolve_group(&mut self, slot: usize) {
+        let Some(group) = self.groups.slots[slot].take() else { return };
+        for (word, mut bits) in group.blocks {
+            self.groups.members[word] &= !bits;
+            self.groups.skipped[word] &= !bits;
+            while bits != 0 {
+                let id = word * 64 + bits.trailing_zeros() as usize;
+                bits &= bits - 1;
+                let cursor =
+                    if self.groups.cursor.is_some_and(|cursor| id >= cursor) { group.before } else { group.after };
+                self.cursors[id].set(cursor);
+                self.groups.owners[id] = NONE;
+                self.groups.woken.push(id);
+            }
+        }
+        self.groups.count -= group.count;
+    }
+
+    pub(crate) fn dissolve_groups(&mut self) {
+        if self.groups.count == 0 {
+            return;
+        }
+        for slot in 0..self.groups.slots.len() {
+            self.dissolve_group(slot);
+        }
+    }
+
+    fn detach_removed_groups(&mut self, members: &[u64]) {
+        if self.groups.count == 0 {
+            return;
+        }
+        for word in 0..self.groups.members.len() {
+            let mut bits = self.groups.members[word] & !members.get(word).copied().unwrap_or(0);
+            while bits != 0 {
+                let id = word * 64 + bits.trailing_zeros() as usize;
+                bits &= bits - 1;
+                self.detach_group(id);
+            }
+        }
+    }
+
+    pub(crate) fn finish_groups(&mut self, members: &[u64]) {
+        self.groups.cursor = None;
+        self.detach_removed_groups(members);
+        self.groups.woken.clear();
+    }
+
+    pub(crate) fn begin_groups(
+        &mut self,
+        members: &[u64],
+        characters: &[EffectCharacter],
+        playback: &mut PlaybackScheduler,
+        allow: bool,
+    ) {
+        debug_assert!(self.groups.cursor.is_none());
+        self.detach_removed_groups(members);
+        if !allow || !self.enabled || !self.groups.enabled {
+            self.dissolve_groups();
+            self.groups.woken.clear();
+            return;
+        }
+        // Admission scans are amortized; established groups tick every update.
+        if self.groups.generation % 4 == 0 {
+            self.form_groups(members, characters, playback);
+        }
+        self.groups.generation = self.groups.generation.wrapping_add(1);
+        for slot in 0..self.groups.slots.len() {
+            let Some(group) = self.groups.slots[slot].as_mut() else { continue };
+            let before = group.after;
+            let mut after = before;
+            if after.ticks + 1 == after.duration && (group.eased.is_some() || after.head + 1 == after.end) {
+                // Leave completion and its callbacks to the normal engine.
+                self.dissolve_group(slot);
+                continue;
+            }
+            after.shown = group.eased.as_ref().map_or(after.head, |plan| plan.runs[after.ticks as usize].frame);
+            after.ticks += 1;
+            if group.eased.is_none() && after.ticks == after.duration {
+                after.ticks = 0;
+                after.head += 1;
+                after.played = after.head;
+            }
+            group.before = before;
+            group.after = after;
+            for &(word, bits) in &group.blocks {
+                if before.shown == after.shown {
+                    self.groups.skipped[word] |= bits;
+                } else {
+                    self.groups.skipped[word] &= !bits;
+                }
+            }
+        }
+        self.groups.cursor = Some(0);
+        self.groups.woken.clear();
+    }
+
+    fn form_groups(&mut self, members: &[u64], characters: &[EffectCharacter], playback: &mut PlaybackScheduler) {
+        if self.stationary_count - self.groups.count < MIN_GROUP {
+            return;
+        }
+        // Pointer identity is only a key while the immutable program's Rc stays
+        // alive. It is never dereferenced or retained after this admission scan.
+        let mut candidates: HashMap<(Cursor, usize), Vec<usize>, FxBuildHasher> = HashMap::default();
+        for (word, &active) in members.iter().enumerate() {
+            let mut bits = active
+                & self.stationary_members.get(word).copied().unwrap_or(0)
+                & !self.groups.members.get(word).copied().unwrap_or(0);
+            while bits != 0 {
+                let id = word * 64 + bits.trailing_zeros() as usize;
+                bits &= bits - 1;
+                let program = self.programs[id].as_ref().unwrap();
+                if program.looping || self.groups.shapes[id] < 0 {
+                    continue;
+                }
+                playback.materialize(id, characters, self);
+                let mut cursor = self.cursors[id].get();
+                if cursor.ticks + 1 == cursor.duration && (program.eased.is_some() || cursor.head + 1 == cursor.end) {
+                    continue;
+                }
+                let plan = if let Some(plan) = &program.eased {
+                    Rc::as_ptr(plan) as usize
+                } else {
+                    if self.groups.shapes[id] == 0 {
+                        // Scene's duration hint is public-mutation-sensitive.
+                        // Validate the actual immutable remaining frame slice.
+                        self.groups.shapes[id] = if program.frames[cursor.head as usize..cursor.end as usize]
+                            .iter()
+                            .all(|frame| frame.duration == cursor.duration)
+                        {
+                            1
+                        } else {
+                            -1
+                        };
+                    }
+                    if self.groups.shapes[id] < 0 {
+                        continue;
+                    }
+                    0
+                };
+                cursor.shown = u32::MAX;
+                candidates.entry((cursor, plan)).or_default().push(id);
+            }
+        }
+        for ((cursor, _), ids) in candidates {
+            if ids.len() < MIN_GROUP {
+                continue;
+            }
+            let slot = if let Some(slot) = self.groups.slots.iter().position(Option::is_none) {
+                slot
+            } else if self.groups.slots.len() < MAX_GROUPS {
+                self.groups.slots.push(None);
+                self.groups.slots.len() - 1
+            } else {
+                break;
+            };
+            let mut blocks: Vec<(usize, u64)> = Vec::new();
+            for &id in &ids {
+                playback.wake(id, characters, self);
+                self.groups.owners[id] = slot;
+                let word = id / 64;
+                let bit = 1 << (id % 64);
+                self.groups.members[word] |= bit;
+                if let Some((_, bits)) = blocks.last_mut().filter(|(last, _)| *last == word) {
+                    *bits |= bit;
+                } else {
+                    blocks.push((word, bit));
+                }
+            }
+            self.groups.count += ids.len();
+            self.groups.slots[slot] = Some(Group {
+                before: cursor,
+                after: cursor,
+                eased: self.programs[ids[0]].as_ref().unwrap().eased.clone(),
+                blocks,
+                count: ids.len(),
+            });
+        }
+    }
+
+    /// Called only from the ordered update loop. Counter work is shared, but
+    /// visual changes still occur at the character's original snapshot position.
+    #[inline]
+    pub(crate) fn group_tick(&self, id: usize, characters: &mut [EffectCharacter]) -> Option<bool> {
+        if self.groups.count == 0 {
+            return None;
+        }
+        let slot = self.groups.owners[id];
+        if slot == NONE {
+            return None;
+        }
+        let group = self.groups.slots[slot].as_ref().unwrap();
+        let frame = group.after.shown;
+        let program = self.programs[id].as_ref().unwrap();
+        let next = &program.frames[frame as usize].character_visual;
+        let current = &mut characters[id].animation.current_character_visual;
+        let changed = !Rc::ptr_eq(current, next);
+        if changed {
+            *current = Rc::clone(next);
+        }
+        Some(changed)
+    }
+}
+
+#[cfg(test)]
+mod tests {
