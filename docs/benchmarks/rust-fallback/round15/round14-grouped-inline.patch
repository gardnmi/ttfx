+
+    fn prepared(ease: Option<Easing>) -> (Vec<EffectCharacter>, SceneRuntime, PlaybackScheduler) {
+        let mut characters = Vec::new();
+        for id in 0..64 {
+            let mut ch = EffectCharacter::new(id, "X", id as i64, 1);
+            ch.motion.previous_coord = ch.motion.current_coord;
+            ch.animation.new_scene(false, None, ease, "scene", false);
+            let scene = ch.animation.scenes.get_mut("scene").unwrap();
+            for letter in ["A", "B", "C", "D"] {
+                scene.add_frame(&format!("{letter}{id}"), 3, VisualParams::default()).unwrap();
+            }
+            ch.animation.current_character_visual = scene.activate().unwrap();
+            ch.animation.active_scene = ch.animation.scenes.handle("scene");
+            characters.push(ch);
+        }
+        let mut runtime = SceneRuntime::default();
+        runtime.enabled = true;
+        runtime.groups.enabled = true;
+        runtime.resize(characters.len());
+        for _ in 0..8 {
+            for id in 0..characters.len() {
+                runtime.prepare(id, &characters, true);
+            }
+        }
+        let mut playback = PlaybackScheduler::default();
+        playback.resize(characters.len());
+        (characters, runtime, playback)
+    }
+
+    #[test]
+    fn groups_share_progress_but_preserve_each_visual_and_exact_easing() {
+        for ease in [None, Some(Easing::OutElastic), Some(Easing::InOutBack)] {
+            let (mut characters, mut runtime, mut playback) = prepared(ease);
+            let mut references: Vec<_> =
+                characters.iter().map(|c| c.animation.scenes.get("scene").unwrap().clone()).collect();
+            let mut cache = EasedTicksCache::default();
+            for _ in 0..11 {
+                playback.begin(&[u64::MAX], &characters, &runtime);
+                runtime.begin_groups(&[u64::MAX], &characters, &mut playback, true);
+                assert_eq!(runtime.groups.count, 64, "test must exercise grouped playback");
+                assert_eq!(runtime.groups.slots.iter().flatten().count(), 1);
+                for id in 0..64 {
+                    runtime.set_group_cursor(id);
+                    assert!(runtime.group_tick(id, &mut characters).is_some());
+                }
+                runtime.finish_groups(&[u64::MAX]);
+                playback.finish(&[u64::MAX], &characters, &runtime);
+                for id in 0..64 {
+                    let reference = &mut references[id];
+                    let frame = if let Some(ease) = ease {
+                        reference.step_eased(ease, &mut cache, false).0
+                    } else {
+                        reference.step_frame()
+                    };
+                    runtime.materialize(id, &characters);
+                    let actual = characters[id].animation.scenes.get("scene").unwrap();
+                    assert_eq!(actual.frames(), reference.frames());
+                    assert_eq!(actual.played_frames(), reference.played_frames());
+                    assert_eq!(actual.ticks_elapsed(), reference.ticks_elapsed());
+                    assert_eq!(actual.easing_current_step(), reference.easing_current_step());
+                    assert_eq!(
+                        characters[id].animation.current_character_visual,
+                        reference.all_frames[frame].character_visual
+                    );
+                }
+            }
+            playback.begin(&[u64::MAX], &characters, &runtime);
+            runtime.begin_groups(&[u64::MAX], &characters, &mut playback, true);
+            assert_eq!(runtime.groups.count, 0, "completion must return to the ordinary engine");
+            assert!(runtime.tick(0, &mut characters, &MotionRuntime::default(), true).is_none());
+        }
+    }
+
+    #[test]
+    fn grouped_holds_materialize_and_detach_on_both_sides_of_callbacks() {
+        let (mut characters, mut runtime, mut playback) = prepared(None);
+        playback.begin(&[u64::MAX], &characters, &runtime);
+        runtime.begin_groups(&[u64::MAX], &characters, &mut playback, true);
+        for id in 0..64 {
+            runtime.set_group_cursor(id);
+            runtime.group_tick(id, &mut characters).unwrap();
+        }
+        runtime.finish_groups(&[u64::MAX]);
+        playback.finish(&[u64::MAX], &characters, &runtime);
+        playback.begin(&[u64::MAX], &characters, &runtime);
+        runtime.begin_groups(&[u64::MAX], &characters, &mut playback, true);
+        assert_eq!(runtime.group_skip_mask(), &[u64::MAX]);
+        runtime.set_group_cursor(32);
+        for (id, expected) in [(16, 2), (48, 1)] {
+            runtime.materialize(id, &characters);
+            assert_eq!(characters[id].animation.scenes.get("scene").unwrap().ticks_elapsed(), expected);
+        }
+        let mut cloned = runtime.clone();
+        cloned.detach_group(16);
+        assert_eq!(cloned.cursors[16].get().ticks, 2);
+        assert_eq!(runtime.groups.count, 64, "clone edits must be independent");
+        runtime.invalidate(48, &characters);
+        assert_eq!(runtime.groups.count, 63);
+        assert_eq!(runtime.groups.woken, [48]);
+        assert_eq!(runtime.group_skip_mask()[0] & (1 << 48), 0);
+        assert_eq!(characters[48].animation.scenes.get("scene").unwrap().ticks_elapsed(), 1);
+        // Explicit tick of an earlier member starts after its implicit tick.
+        runtime.detach_group(16);
+        assert!(runtime.tick(16, &mut characters, &MotionRuntime::default(), true).is_some());
+        runtime.materialize(16, &characters);
+        assert_eq!(characters[16].animation.scenes.get("scene").unwrap().frames().start, 1);
+        runtime.finish_groups(&[u64::MAX]);
+        runtime.materialize(60, &characters);
+        assert_eq!(characters[60].animation.scenes.get("scene").unwrap().ticks_elapsed(), 2);
+    }
+
+    #[test]
+    fn grouping_validates_real_durations_after_public_frame_replacement() {
+        let (mut characters, mut runtime, mut playback) = prepared(None);
+        for id in 0..64 {
+            runtime.invalidate(id, &characters);
+            let scene = characters[id].animation.scenes.get_mut("scene").unwrap();
+            assert_eq!(scene.uniform_frame_duration(), Some(3));
+            let FrameStorage::Shared(frames) = &mut scene.all_frames else { panic!("prepared frames") };
+            Rc::make_mut(frames)[1].duration = 7;
+            // Public replacement bypasses the construction-time duration hint.
+            assert_eq!(scene.uniform_frame_duration(), Some(3));
+            runtime.prepare(id, &characters, true);
+        }
+        playback.begin(&[u64::MAX], &characters, &runtime);
+        runtime.begin_groups(&[u64::MAX], &characters, &mut playback, true);
+        assert_eq!(runtime.groups.count, 0);
+        assert_eq!(runtime.group_skip_mask(), &[0]);
+    }
+}
