#!/usr/bin/env sh
# Rust/reference suites shared by local development and CI. Common Cargo
# build/test options, such as --no-default-features, are forwarded to both.
# bin/test-asm separately requires assembly coverage.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

for tool in cargo python3; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "$tool is required to run the ttfx tests." >&2
    exit 1
  fi
done

cd "$ROOT"

cargo test --release "$@"
"$ROOT/bin/build" "$@"
./tools/tests/cli_corpus.sh
python3 tools/tests/sigterm_behavior.py
python3 tools/tests/terminal_close_behavior.py

# Bit-exact parity is pinned to Linux/glibc (plan.md §5.20) — elsewhere the
# reference was never promised to match. The resize suite goes with it: its
# timings are calibrated on that runner, so a slower one would only flake.
if [ "$(uname -s)" = "Linux" ]; then
  ./tools/parity/fetch_reference.sh
  ./tools/parity/run_suite.sh
  ./tools/parity/tty_compare.sh
  python3 tools/tests/resize_behavior.py
fi
