+/// Different paths often use the same easing curve and step count. Reuse the
+/// exact scalar factors; multiplication by each path's distance stays in order.
+#[derive(Debug, Clone)]
+struct FactorShape {
+    ease: Easing,
+    steps: i64,
+    uses: u8,
+    values: Option<Rc<[f64]>>,
+}
+
+#[derive(Debug, Clone, Default)]
+struct MotionFactors {
+    shapes: Vec<FactorShape>,
+    last: usize,
+    next: usize,
+}
+
+impl MotionFactors {
+    fn get(&mut self, ease: Easing, steps: i64) -> Option<Rc<[f64]>> {
+        if !(2..=4096).contains(&steps) || ease == Easing::Linear {
+            return None;
+        }
+        let matches = |shape: &FactorShape| shape.ease == ease && shape.steps == steps;
+        let slot = if self.shapes.get(self.last).is_some_and(matches) {
+            self.last
+        } else if let Some(slot) = self.shapes.iter().position(matches) {
+            slot
+        } else {
+            let shape = FactorShape { ease, steps, uses: 0, values: None };
+            if self.shapes.len() < 16 {
+                self.shapes.push(shape);
+                self.shapes.len() - 1
+            } else {
+                let slot = (0..16).map(|offset| (self.next + offset) % 16)
+                    .find(|&slot| self.shapes[slot].values.as_ref().is_none_or(|values| Rc::strong_count(values) == 1))?;
+                self.shapes[slot] = shape;
+                self.next = (slot + 1) % 16;
+                slot
+            }
+        };
+        self.last = slot;
+        let shape = &mut self.shapes[slot];
+        if shape.values.is_none() {
+            shape.uses += 1;
+            if shape.uses < 8 { return None; }
+            shape.values = Some((0..steps).map(|step| ease.ease(step as f64 / steps as f64)).collect());
+        }
+        shape.values.clone()
+    }
+}
