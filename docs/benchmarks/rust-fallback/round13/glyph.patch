+#[test]
+fn cached_symbol_bytes_do_not_retain_visual_owners_and_follow_heap_symbol_changes() {
+    let mut t = Terminal::new(
+        "AB",
+        TerminalConfig { canvas_width: 12, canvas_height: 3, ignore_terminal_dimensions: true, ..Default::default() },
+    ).unwrap();
+    for id in t.input_characters.clone() { t.set_character_visibility(id, true); }
+    assert_eq!(t.get_formatted_output_string(), reference(&t));
+    for symbol in ["界".repeat(80), "x".into(), "λ".repeat(90), "".into()] {
+        let old = Rc::downgrade(&t.arena[0].animation.current_character_visual);
+        t.arena[0].animation.set_appearance("A", false, Some(&symbol), None);
+        assert!(old.upgrade().is_none());
+        assert_eq!(t.get_formatted_output_string(), reference(&t));
+        t.arena[0].motion.current_coord = Coord::new(2, 1);
+        t.arena[0].layer += 1;
+        assert_eq!(t.get_formatted_output_string(), reference(&t));
+    }
+}
