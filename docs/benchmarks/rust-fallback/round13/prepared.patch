+    /// Consume a consecutive run of ticks that cannot emit events. Stop at the
+    /// first ordinary tick, preserving ascending callback order. The returned
+    /// flag says whether movement already advanced and only animation remains.
+    #[inline(never)]
+    pub(crate) fn tick_prepared_run(
+        &mut self,
+        word: usize,
+        pending: &mut u64,
+        allow_idle: bool,
+        untraced: bool,
+    ) -> Option<(usize, bool)> {
+        while *pending != 0 {
+            let id = word * 64 + pending.trailing_zeros() as usize;
+            *pending &= *pending - 1;
+            self.playback.set_cursor(id);
+            if self.scene_tick(id, allow_idle, false, untraced) {
+                continue;
+            }
+            if untraced && self.motion_tick(id) {
+                if self.scene_tick(id, false, true, true) || !self.has_scene(id) {
+                    continue;
+                }
+                return Some((id, true));
+            }
+            return Some((id, false));
+        }
+        None
+    }
