+#[cfg(test)]
+mod hidden_render_tests {
+    use super::*;
+    use crate::engine::animation::VisualParams;
+
+    #[test]
+    fn hidden_engine_edits_preserve_playback_and_public_visibility_invalidation() {
+        let mut character = EffectCharacter::new(0, "X", 1, 1);
+        character.motion.previous_coord = character.motion.current_coord;
+        character.animation.new_scene(false, None, None, "change", false);
+        let scene = character.animation.scenes.get_mut("change").unwrap();
+        scene.add_frame("A", 1, VisualParams::default()).unwrap();
+        scene.add_frame("B", 4, VisualParams::default()).unwrap();
+        character.animation.current_character_visual = scene.activate().unwrap();
+        character.animation.active_scene = character.animation.scenes.handle("change");
+        let mut arena = CharacterArena::from(vec![character]);
+        arena.scene_runtime.enabled = true;
+        arena.take_dirty();
+        assert!(arena.prepare_scene(0, true));
+        assert!(arena.scene_tick(0, false, false, true));
+        assert!(arena.scene_tick(0, false, false, true));
+        assert_eq!(arena[0].animation.current_character_visual.symbol, "B");
+        assert_eq!(arena[0].animation.scenes.get("change").unwrap().ticks_elapsed(), 1);
+        assert_eq!(arena.dirty_len(), 0);
+        arena.set_appearance(0, Some("C"), None);
+        {
+            let mut edit = arena.animation_edit(0);
+            edit.set_appearance("X", false, Some("D"), None);
+        }
+        assert_eq!(arena[0].animation.current_character_visual.symbol, "D");
+        assert_eq!(arena.dirty_len(), 0);
+        // Public edits still mark before exposing unrestricted mutable fields.
+        arena[0].is_visible = true;
+        assert!(arena.layout_changed());
+        assert_eq!(arena.dirty_len(), 1);
+        arena.take_dirty();
+        arena.set_appearance(0, Some("E"), None);
+        assert_eq!(arena.dirty_len(), 1);
+        arena.take_dirty();
+        arena[0].is_visible = false;
+        arena.set_appearance(0, Some("F"), None);
+        assert_eq!(arena.dirty_len(), 1, "hidden edits cannot erase pending visibility changes");
+    }
+}
